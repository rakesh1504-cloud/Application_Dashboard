# Copy to .env and fill in. Flask reads this file automatically.

# PostgreSQL connection. Leave unset to use a local SQLite file (instance/cms.sqlite).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://cms_app:change-me@localhost:5432/cms

# Add ?sslmode=require (or verify-full) for an encrypted connection to an internal server:
# DATABASE_URL=postgresql://cms_app:change-me@pg01.corp.local:5432/cms?sslmode=require

# Session signing key - set a long random value in production.
CMS_SECRET_KEY=change-me

# Set to 1 when running behind a load balancer / reverse proxy so the audit log
# records the real client IP.
# CMS_TRUST_PROXY=1
